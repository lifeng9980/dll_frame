{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ir-sdk.local/schemas/station.schema.json",
  "title": "IR SDK Station Configuration (schema_version 1)",
  "description": "Describes the frame acquisition source and optional instruments available on a measurement station.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acquisition"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor validation and autocompletion."
    },
    "schema_version": {
      "const": 1,
      "description": "Station configuration schema version."
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "source",
        "valid_bits"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "raw_replay",
            "directshow",
            "v4l2"
          ],
          "description": "Frame source backend. directshow is Windows-only; v4l2 is Linux-only."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "RAW16 directory (relative to station JSON or absolute), DirectShow camera name, or V4L2 device node."
        },
        "valid_bits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "Effective bit depth per uint16 pixel (0 = read from RAW index or unknown)."
        },
        "max_batch_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807,
          "default": 268435456,
          "description": "Maximum RAW16 frame batch pixel buffer size in bytes (default 256 MiB)."
        },
        "max_inflight_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807,
          "default": 1073741824,
          "description": "Maximum SDK-managed capture, frame batch, image map, and mask storage (default 1 GiB)."
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096,
          "default": 64,
          "description": "Bounded FrameQueue capacity in frames for live measurement buffering (default 64)."
        }
      }
    },
    "devices": {
      "type": "object",
      "description": "Map of user-defined device alias to instrument definition.",
      "additionalProperties": {
        "$ref": "#/$defs/device"
      }
    },
    "plugins": {
      "type": "array",
      "description": "Optional metric plugin library or directory paths (relative to station JSON or absolute).",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "oneOf": [
        {
          "$ref": "#/$defs/pcn7ltDevice"
        },
        {
          "$ref": "#/$defs/dcn1000Device"
        },
        {
          "$ref": "#/$defs/it6332aDevice"
        },
        {
          "$ref": "#/$defs/gwsStenDevice"
        },
        {
          "$ref": "#/$defs/dmm6500Device"
        },
        {
          "$ref": "#/$defs/detectorSerialDevice"
        },
        {
          "$ref": "#/$defs/coolerModbusDevice"
        }
      ]
    },
    "pcn7ltDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "connection"
      ],
      "properties": {
        "kind": {
          "const": "pcn7-lt"
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "tcp_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 2101
            },
            "head": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1,
              "default": -1
            },
            "expected_head_serial": {
              "type": "string",
              "description": "Optional head serial verification; requires head >= 0 when non-empty."
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000,
              "default": 3000
            }
          },
          "if": {
            "required": [
              "expected_head_serial"
            ],
            "properties": {
              "expected_head_serial": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "then": {
            "required": [
              "head"
            ],
            "properties": {
              "head": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "dcn1000Device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "connection"
      ],
      "properties": {
        "kind": {
          "const": "dcn1000"
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000,
              "default": 3000
            }
          }
        }
      }
    },
    "it6332aDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "connection"
      ],
      "properties": {
        "kind": {
          "const": "it6332a"
        },
        "connection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "string",
                  "minLength": 1
                },
                "baud_rate": {
                  "type": "integer",
                  "minimum": 1200,
                  "maximum": 921600,
                  "default": 115200
                },
                "data_bits": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 8,
                  "default": 8
                },
                "parity": {
                  "type": "string",
                  "enum": ["none", "odd", "even"],
                  "default": "none"
                },
                "stop_bits": {
                  "type": "integer",
                  "enum": [1, 2],
                  "default": 1
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000,
                  "default": 1200
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "tcp_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "default": 5026
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60000,
                  "default": 1200
                }
              }
            }
          ]
        }
      }
    },
    "gwsStenDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connection"],
      "properties": {
        "kind": { "const": "gws-sten" },
        "connection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "string", "minLength": 1 },
                "baud_rate": { "type": "integer", "minimum": 1200, "maximum": 921600, "default": 9600 },
                "data_bits": { "type": "integer", "minimum": 5, "maximum": 8, "default": 8 },
                "parity": { "type": "string", "enum": ["none", "odd", "even"], "default": "none" },
                "stop_bits": { "type": "integer", "enum": [1, 2], "default": 1 },
                "address": { "type": "integer", "minimum": 1, "maximum": 255, "default": 1 },
                "delimiter": { "type": "string", "enum": ["crlf", "cr", "lf"], "default": "crlf" },
                "min_setpoint_c": { "type": "number", "default": -45.0 },
                "max_setpoint_c": { "type": "number", "default": 70.0 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["host"],
              "properties": {
                "host": { "type": "string", "minLength": 1 },
                "tcp_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5000 },
                "address": { "type": "integer", "minimum": 1, "maximum": 255, "default": 1 },
                "delimiter": { "type": "string", "enum": ["crlf", "cr", "lf"], "default": "crlf" },
                "min_setpoint_c": { "type": "number", "default": -45.0 },
                "max_setpoint_c": { "type": "number", "default": 70.0 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000 }
              }
            }
          ]
        }
      }
    },
    "dmm6500Device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connection"],
      "properties": {
        "kind": { "const": "dmm6500" },
        "connection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "string", "minLength": 1 },
                "baud_rate": { "type": "integer", "minimum": 1200, "maximum": 921600, "default": 115200 },
                "data_bits": { "type": "integer", "minimum": 5, "maximum": 8, "default": 8 },
                "parity": { "type": "string", "enum": ["none", "odd", "even"], "default": "none" },
                "stop_bits": { "type": "integer", "enum": [1, 2], "default": 1 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["host"],
              "properties": {
                "host": { "type": "string", "minLength": 1 },
                "tcp_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5025 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000 }
              }
            }
          ]
        }
      }
    },
    "detectorSerialDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connection"],
      "properties": {
        "kind": { "const": "detector-serial" },
        "connection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "string", "minLength": 1 },
                "baud_rate": { "type": "integer", "minimum": 1200, "maximum": 921600, "default": 115200 },
                "data_bits": { "type": "integer", "minimum": 5, "maximum": 8, "default": 8 },
                "parity": { "type": "string", "enum": ["none", "odd", "even"], "default": "none" },
                "stop_bits": { "type": "integer", "enum": [1, 2], "default": 1 },
                "inter_command_ms": { "type": "integer", "minimum": 0, "maximum": 2000, "default": 0 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 1200 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["host"],
              "properties": {
                "host": { "type": "string", "minLength": 1 },
                "tcp_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 2102 },
                "inter_command_ms": { "type": "integer", "minimum": 0, "maximum": 2000, "default": 0 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 1200 }
              }
            }
          ]
        }
      }
    },
    "coolerModbusDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "connection"],
      "properties": {
        "kind": { "const": "cooler-modbus" },
        "connection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "string", "minLength": 1 },
                "baud_rate": { "type": "integer", "minimum": 1200, "maximum": 921600, "default": 9600 },
                "data_bits": { "type": "integer", "minimum": 5, "maximum": 8, "default": 8 },
                "parity": { "type": "string", "enum": ["none", "odd", "even"], "default": "none" },
                "stop_bits": { "type": "integer", "enum": [1, 2], "default": 2 },
                "slave_address": { "type": "integer", "minimum": 1, "maximum": 247, "default": 1 },
                "register_address": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 31314 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["host"],
              "properties": {
                "host": { "type": "string", "minLength": 1 },
                "tcp_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5020 },
                "slave_address": { "type": "integer", "minimum": 1, "maximum": 247, "default": 1 },
                "register_address": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 31314 },
                "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000, "default": 2000 }
              }
            }
          ]
        }
      }
    }
  }
}
