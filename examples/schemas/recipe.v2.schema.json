{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ir-sdk.local/schemas/recipe.v2.schema.json",
  "title": "IR SDK Measurement Recipe Configuration (schema_version 2)",
  "description": "Flexible multi-condition, optional-archive, open-operator, and periodic repeat_burst measurement recipe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor validation and autocompletion."
    },
    "schema_version": {
      "const": 2,
      "description": "Recipe schema version 2."
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1,
      "description": "Product or test procedure identifier written into result.json."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topLevelStep"
      },
      "description": "Ordered sequence of controls, flush, capture, analyze, optional save_raw, and repeat_burst blocks."
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blackbody_standby": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blackbodyStandbyEntry"
          }
        },
        "oven_standby": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyIdentifier"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limit"
      }
    }
  },
  "$defs": {
    "nonEmptyIdentifier": {
      "type": "string",
      "minLength": 1
    },
    "relativeSingleName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\:]+$"
    },
    "blackbodyStandbyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "target_c"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "target_c": {
          "type": "number",
          "minimum": -60.0,
          "maximum": 100.0
        }
      }
    },
    "blackbodyStabilizeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "device",
        "target_c",
        "tolerance_c",
        "stable_window_ms",
        "timeout_ms",
        "require_device_stable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "blackbody_stabilize"
        },
        "device": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "target_c": {
          "type": "number",
          "minimum": -60.0,
          "maximum": 100.0
        },
        "tolerance_c": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "stable_window_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "require_device_stable": {
          "type": "boolean"
        }
      }
    },
    "powerSetStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "device",
        "channel",
        "voltage_v",
        "current_limit_a"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "power_set"
        },
        "device": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "voltage_v": {
          "type": "number",
          "minimum": 0.0
        },
        "current_limit_a": {
          "type": "number",
          "exclusiveMinimum": 0.0
        }
      }
    },
    "powerOutputStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "device",
        "channel",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "power_output"
        },
        "device": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "enabled": {
          "type": "boolean"
        },
        "off_after_run": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "off_after_run"
        ],
        "properties": {
          "off_after_run": {
            "const": true
          }
        }
      }
    },
    "powerReadStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "device",
        "channel"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "power_read"
        },
        "device": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "powerWaitStableStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "device",
        "channel"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "power_wait_stable" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "channel": { "type": "integer", "minimum": 1, "maximum": 3 },
        "expected_voltage_v": { "type": "number", "minimum": 0.0, "default": 0.0 },
        "voltage_tolerance_v": { "type": "number", "minimum": 0.0, "default": 0.15 },
        "max_current_a": { "type": "number", "minimum": 0.0, "default": 0.0 },
        "startup_threshold_a": { "type": "number", "minimum": 0.0, "default": 0.3 },
        "startup_required_samples": { "type": "integer", "minimum": 0, "maximum": 100000, "default": 3 },
        "startup_timeout_ms": { "type": "integer", "minimum": 0, "maximum": 86400000, "default": 30000 },
        "stable_threshold_a": { "type": "number", "exclusiveMinimum": 0.0, "default": 0.3 },
        "max_variation_a": { "type": "number", "minimum": 0.0, "default": 0.02 },
        "stable_required_samples": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 5 },
        "sample_interval_ms": { "type": "integer", "minimum": 0, "maximum": 60000, "default": 200 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000, "default": 600000 }
      }
    },
    "ovenStabilizeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "device",
        "target_c",
        "tolerance_c",
        "stable_window_ms",
        "timeout_ms"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "oven_stabilize" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "target_c": { "type": "number", "minimum": -100.0, "maximum": 250.0 },
        "tolerance_c": { "type": "number", "exclusiveMinimum": 0.0 },
        "stable_window_ms": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "require_no_alarm": { "type": "boolean", "default": true },
        "standby_after_run": { "type": "boolean", "default": false }
      }
    },
    "ovenStandbyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "oven_standby" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" }
      }
    },
    "dmmReadStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "dmm_read" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "name": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "mode": {
          "type": "string",
          "enum": ["any", "dcv", "dci", "res", "diode"],
          "default": "any"
        },
        "set_mode": { "type": "boolean", "default": false }
      },
      "if": {
        "properties": { "set_mode": { "const": true } },
        "required": ["set_mode"]
      },
      "then": {
        "required": ["mode"],
        "properties": { "mode": { "enum": ["dcv", "dci", "res", "diode"] } }
      }
    },
    "detectorTimingStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device", "integration_us", "frame_hz"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "detector_timing" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "integration_us": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "frame_hz": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "empty_us": { "type": "integer", "minimum": 0, "maximum": 16777215, "default": 0 }
      }
    },
    "detectorGpolStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device", "gpol_v"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "detector_gpol" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "gpol_v": { "type": "number", "minimum": 0.0, "maximum": 5.0 }
      }
    },
    "detectorRegisterStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device", "command_code", "payload_hex"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "detector_register" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "command_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "payload_hex": { "type": "string", "pattern": "^([0-9A-Fa-f]{2}){1,255}$" }
      }
    },
    "detectorCurrentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device", "gain_code", "channel_code"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "detector_current" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "name": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "gain_code": { "type": "integer", "minimum": 0, "maximum": 7 },
        "channel_code": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "coolerReadStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "device"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "type": { "const": "cooler_read" },
        "device": { "$ref": "#/$defs/nonEmptyIdentifier" },
        "name": { "$ref": "#/$defs/nonEmptyIdentifier" }
      }
    },
    "flushFramesStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "flush_frames"
        },
        "discard_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000,
          "default": 2000
        }
      }
    },
    "captureStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "frames",
        "frame_timeout_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "capture"
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "frame_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "output": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        }
      }
    },
    "analyzeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "method"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "analyze"
        },
        "method": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "temporal_noise",
                "roi_mean",
                "frame_stats",
                "map_summary",
                "two_point_nuc",
                "spatial_filter",
                "map_binary_op",
                "threshold_mask",
                "mask_combine",
                "gb_evaluate",
                "gjb_evaluate",
                "gjb_burst",
                "noise3d_compute",
                "channel_spectrum",
                "flicker_detect",
                "fft2d"
              ]
            },
            {
              "pattern": "^plugin:[a-z0-9_]+(\\.[a-z0-9_]+)*$"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1
        },
        "name": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "input": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyIdentifier"
          }
        },
        "params": {
          "type": "object"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyIdentifier"
          }
        }
      }
    },
    "saveRawStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "input"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "save_raw"
        },
        "input": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "subdir": {
          "$ref": "#/$defs/relativeSingleName"
        }
      }
    },
    "innerStep": {
      "oneOf": [
        {
          "$ref": "#/$defs/blackbodyStabilizeStep"
        },
        {
          "$ref": "#/$defs/powerSetStep"
        },
        {
          "$ref": "#/$defs/powerOutputStep"
        },
        {
          "$ref": "#/$defs/powerReadStep"
        },
        {
          "$ref": "#/$defs/powerWaitStableStep"
        },
        {
          "$ref": "#/$defs/ovenStabilizeStep"
        },
        {
          "$ref": "#/$defs/ovenStandbyStep"
        },
        {
          "$ref": "#/$defs/dmmReadStep"
        },
        {
          "$ref": "#/$defs/detectorTimingStep"
        },
        {
          "$ref": "#/$defs/detectorGpolStep"
        },
        {
          "$ref": "#/$defs/detectorRegisterStep"
        },
        {
          "$ref": "#/$defs/detectorCurrentStep"
        },
        {
          "$ref": "#/$defs/coolerReadStep"
        },
        {
          "$ref": "#/$defs/flushFramesStep"
        },
        {
          "$ref": "#/$defs/captureStep"
        },
        {
          "$ref": "#/$defs/analyzeStep"
        }
      ]
    },
    "repeatBurstStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "type": {
          "const": "repeat_burst"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0.0,
          "default": 0.0
        },
        "interval_sec": {
          "type": "number",
          "minimum": 0.0,
          "default": 0.0
        },
        "csv_file": {
          "$ref": "#/$defs/relativeSingleName",
          "default": "burst_summary.csv"
        },
        "record_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyIdentifier"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/innerStep"
          }
        }
      }
    },
    "topLevelStep": {
      "oneOf": [
        {
          "$ref": "#/$defs/blackbodyStabilizeStep"
        },
        {
          "$ref": "#/$defs/powerSetStep"
        },
        {
          "$ref": "#/$defs/powerOutputStep"
        },
        {
          "$ref": "#/$defs/powerReadStep"
        },
        {
          "$ref": "#/$defs/powerWaitStableStep"
        },
        {
          "$ref": "#/$defs/ovenStabilizeStep"
        },
        {
          "$ref": "#/$defs/ovenStandbyStep"
        },
        {
          "$ref": "#/$defs/dmmReadStep"
        },
        {
          "$ref": "#/$defs/detectorTimingStep"
        },
        {
          "$ref": "#/$defs/detectorGpolStep"
        },
        {
          "$ref": "#/$defs/detectorRegisterStep"
        },
        {
          "$ref": "#/$defs/detectorCurrentStep"
        },
        {
          "$ref": "#/$defs/coolerReadStep"
        },
        {
          "$ref": "#/$defs/flushFramesStep"
        },
        {
          "$ref": "#/$defs/captureStep"
        },
        {
          "$ref": "#/$defs/analyzeStep"
        },
        {
          "$ref": "#/$defs/saveRawStep"
        },
        {
          "$ref": "#/$defs/repeatBurstStep"
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "value",
        "unit"
      ],
      "properties": {
        "metric": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        },
        "operator": {
          "type": "string",
          "enum": [
            "max",
            "min"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyIdentifier"
        }
      }
    }
  }
}
