{
  "schema_version": 1,
  "recipe_id": "sim-blackbody-noise-v1",
  "steps": [
    {"id": "stable", "type": "blackbody_stabilize", "device": "bb", "target_c": 32.0,
     "tolerance_c": 0.1, "stable_window_ms": 200, "timeout_ms": 5000,
     "require_device_stable": true},
    {"id": "batch", "type": "capture", "frames": 2, "frame_timeout_ms": 1000},
    {"id": "noise", "type": "analyze", "method": "temporal_noise", "name": "noise", "input": "batch"},
    {"id": "archive", "type": "save_raw", "input": "batch"}
  ],
  "limits": [
    {"metric": "noise.temporal_noise_dn", "operator": "max", "value": 2.0, "unit": "DN"}
  ]
}
