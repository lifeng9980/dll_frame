{
  "schemav": 1,
  "recipe_id": "offline-noise-and-roi",
  "steps": [
    {"id": "batch", "type": "capture", "frames": 2, "frame_timeout_ms": 0, "output": "batch"},
    {"id": "noise", "type": "analyze", "method": "temporal_noise", "name": "noise", "input": "batch"},
    {"id": "roi", "type": "analyze", "method": "roi_mean", "name": "roi", "input": "batch",
     "params": {"x": 0, "y": 0, "width": 160, "height": 128}},
    {"id": "archive", "type": "save_raw", "input": "batch"}
  ],
  "limits": [
    {"metric": "noise.temporal_noise_dn", "operator": "max", "value": 50.0, "unit": "DN"}
  ]
}
